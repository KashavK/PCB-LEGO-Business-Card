	(gr_text "Since 1934"
		(at 174.64 113.01 0)
		(layer "F.SilkS")
		(uuid "dd01f6c6-ab81-4579-adc4-7c4dfcdb30d7")
		(effects
			(font
				(size 1.5 1.5)
				(thickness 0.254)
			)
			(justify right bottom)
		)
	)
	(gr_text "Founded in 1932 by Ole Kirk Christiansen in Billund, Denmark, The LEGO Group is a privately held, \nfamily-owned company and the world's leading manufacturer of play materials. The company's name \nis derived from the Danish phrase leg godt, meaning {dblquote}play well.{dblquote}\n\nDriven by the legendary motto {dblquote}Only the best is good enough,{dblquote} LEGO is dedicated to the philosophy\n of {dblquote}Learning-through-Play.{dblquote} By manufacturing highly precise, interlocking plastic bricks, the \ncompany provides creative, high-quality building experiences that unlock human potential, \nfoster systematic reasoning, and develop the builders of tomorrow. Today, 25% of the \ncompany's profits go directly to the LEGO Foundation to fund global children's development \nand education initiatives."
		(at 133.56 82.56 -0)
		(layer "B.SilkS")
		(uuid "ce444ebd-6f29-4692-8141-9cafbe68e3e6")
		(effects
			(font
				(size 1.1 1.1)
				(thickness 0.254)
			)
			(justify top mirror)
		)
	)
